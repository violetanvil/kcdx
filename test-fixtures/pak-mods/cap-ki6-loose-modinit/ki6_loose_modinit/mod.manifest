<?xml version="1.0" encoding="utf-8"?>
<kcd_mod>
	<info>
		<name>KCDX KI-0006 loose mod-init probe</name>
		<description>PROBE A vehicle — a mod whose scripts/mods/ki6_loose_modinit.lua is LOOSE (NOT in a pak), so the engine's mod-init open routes through CCryFile::Open -> ICryPak::FOpen (HOOK 2's lane). Its file scope logs KCDX_KI6_MODINIT_RAN (the baseline: the engine ran this loose init at all). Remove after the KI-0006 serve-execute question is answered.</description>
		<author>VioletAnvil</author>
		<version>1.0.0</version>
		<modid>ki6_loose_modinit</modid>
		<created_on>2026-06-04</created_on>
	</info>
</kcd_mod>
