# Build outputs
build/
out/
cmake-build-*/
*.asi
!examples/**/*.asi  # keep examples if any
*.dll
!vendor/**/*.dll
!examples/**/*.dll  # example plugin DLLs ship via release zips
*.exe
*.pdb
*.exp
*.lib
*.obj
*.o
*.a

# IDE / tooling
.vs/
.vscode/
*.user
*.suo
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Logs
*.log

# Local artifacts not for source control
# _download/ — cached downloads (ULAH zip etc.); regenerated by build/release scripts
# release-staging/ — generated drag-drop release; produced by release scripts
# test-install/ — local staging area used when iterating against the live game
_download/
release-staging/
test-install/

# Reverse-engineering toolchain. The pre-analyzed Ghidra project and the
# Ghidra install are multi-GB binaries — kept in-tree for local use but never
# committed. Helper scripts and a setup README under third-party-ghidra/ stay
# tracked. WHGame.dll is the game binary; never commit it.
third-party-ghidra/ghidra_project/
third-party-ghidra/ghidra_12.1_PUBLIC/
third-party-ghidra/x64dbg/
third-party-ghidra/ninja/
third-party-ghidra/WHGame.dll
third-party-ghidra/*.fidb
third-party-ghidra/*.log

# Built pak fixtures are binary; keep probe Lua source + manifests tracked,
# ignore the compiled .pak blobs.
test-fixtures/pak-mods/**/*.pak

# RE research scratch under _research/ is tracked (recon notes, the
# address-library seed, ABI walker, phase-N reports). EXCEPT the
# predecessor-sig clones — those are shallow clones of third-party repos
# with their own nested .git dirs; re-cloneable, never committed here.
_research/predecessor-sigs/

# Generated Ghidra dump artifacts (function inventories, statement/anchor
# dumps) are large and regenerable from the committed ghidra_scripts via the
# recipe in each dir's notes — track the scripts + findings, not the output.
_research/parallel-ghidra-research/**/*.csv
_research/parallel-ghidra-research/**/*.jsonl