{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-comment-density.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-probe-stack.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-public-private-refs.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-seed-approval.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-deletion-sweep.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-rationale-consent.ps1" }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-comment-density.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-probe-stack.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-public-private-refs.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-seed-approval.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-deletion-sweep.ps1" },
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-rationale-consent.ps1" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-push-target.ps1" }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -File .claude/hooks/guard-push-target.ps1" }
        ]
      }
    ]
  }
}
